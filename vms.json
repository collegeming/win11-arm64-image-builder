{
  "name": "Windows 11 Pro 26H2 ARM64 (DroidVM)",
  "backend": "crosvm",
  "hypervisor": "auto",
  "protected_vm": "protected_without_firmware",
  "memory_mb": 1792,
  "swiotlb_mb": 256,
  "cpu_count": 2,
  "smt": true,
  "pmu": true,
  "hugepages": true,
  "prepare_lend_mthp": "disabled",
  "usb": false,
  "peripherals": [],
  "balloon": false,
  "rng": true,
  "sandbox": false,
  "screens": {
    "simplefb": { "enabled": true, "exporter": "native", "input_enabled": true, "width": 1280, "height": 720, "poll_hz": 30 },
    "gpu-0": { "enabled": false, "exporter": "none", "width": 1280, "height": 720, "refresh_rate": 60, "dpi_h": 160, "dpi_v": 160 }
  },
  "display_blit_provider": "system",
  "auto_up": false,
  "serial_ports": [
    { "hardware": "serial", "num": 1, "backend": "app_console", "console": true, "fixed": true },
    { "hardware": "serial", "num": 2, "backend": "sink", "fixed": true },
    { "hardware": "serial", "num": 3, "backend": "sink", "fixed": true },
    { "hardware": "serial", "num": 4, "backend": "sink", "fixed": true }
  ],
  "boot": { "protocol": "uefi", "uefi": { "vars_enabled": true, "vars": "", "firmware": "" } },
  "networks": [
    {
      "pkg_network_ref": "net0",
      "pkg_network": {
        "schema": 2,
        "name": "wifi-nat",
        "bridge_name": "br-wifi-nat",
        "bridge_type": "linux",
        "uplink_mode": "l3",
        "stp": false,
        "auto_up": true,
        "l3": {
          "vlans": [
            {
              "vlan_id": 0,
              "ipv4": {
                "cidr": "192.168.58.1/24",
                "dhcp": { "offset_start": 128, "offset_end": 192, "enabled": true },
                "snat": true
              },
              "ipv6": {
                "cidr": "fd00:58::1/64",
                "source": "static",
                "snat": false,
                "slaac": { "enabled": false },
                "dhcp": { "offset_start": 128, "offset_end": 192, "enabled": false }
              },
              "ipv4_secondary": [],
              "ipv6_secondary": [],
              "dns_servers": []
            }
          ]
        }
      }
    }
  ]
}
